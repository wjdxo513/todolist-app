NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# PostgreSQL 17. CHANGE_ME를 로컬 DB 비밀번호로 바꾼다
DB_CONN_STRING=postgresql://postgres:CHANGE_ME@localhost:5432/postgres
# 테스트 DB. 이름이 _test로 끝나야 한다(tests/setup.js)
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/todolist_test
DB_POOL_MAX=10
# 64자 이상. 생성: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
BCRYPT_COST=10
# CORS 허용 출처. 쉼표로 여러 개(예: http://localhost:5173,https://app.example.com). 운영(production) 필수
FRONTEND_ORIGIN=http://localhost:5173
